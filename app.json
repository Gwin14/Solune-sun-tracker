{
  "expo": {
    "name": "Solune",
    "slug": "solune",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "solune",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.fabiosantos.solune",
      "supportsTablet": false,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "CFBundleDevelopmentRegion": "pt-BR"
      },
      "appleTeamId": "77MXYLFJ7J"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1043",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fabiosantos.solune"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060A1C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Solune usa a câmera para desenhar o trajeto do sol e da lua sobre o céu. Nada é gravado.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "O Solune usa os sensores de movimento para saber para onde você aponta o celular no modo AR."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sua localização torna os horários do sol e da lua precisos ao minuto."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFB648"
        }
      ],
      "expo-font",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.fabiosantos.solune",
          "widgets": [
            {
              "name": "SunWidget",
              "displayName": "Sol",
              "description": "O próximo nascer ou pôr do sol e a curva do dia.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              },
              "android": null
            },
            {
              "name": "GoldenWidget",
              "displayName": "Horas mágicas",
              "description": "A próxima hora dourada e a hora azul, com contagem.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            },
            {
              "name": "MoonWidget",
              "displayName": "Lua",
              "description": "A fase de hoje, a iluminação e a próxima lua cheia.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            },
            {
              "name": "LockWidget",
              "displayName": "Céu no bloqueio",
              "description": "Sol, lua ou hora dourada na Tela Bloqueada.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "configuration": {
                  "title": "Céu no bloqueio",
                  "description": "Escolha o que acompanhar.",
                  "parameters": {
                    "focus": {
                      "title": "Mostrar",
                      "type": "enum",
                      "values": [
                        {
                          "name": "Sol",
                          "value": "sun"
                        },
                        {
                          "name": "Lua",
                          "value": "moon"
                        },
                        {
                          "name": "Hora dourada",
                          "value": "golden"
                        }
                      ],
                      "default": "sun"
                    }
                  }
                }
              },
              "android": null
            },
            {
              "name": "StreakWidget",
              "displayName": "Sequência",
              "description": "Seus dias seguidos olhando o céu.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            },
            {
              "name": "EventWidget",
              "displayName": "Próximo evento",
              "description": "Eclipses, superluas, solstícios e chuvas de meteoros.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            }
          ]
        }
      ],
      "expo-app-intents",
      "expo-quick-actions"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    },
    "backgroundColor": "#060A1C"
  }
}
